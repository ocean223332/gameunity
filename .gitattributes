# Normalize new text while protecting binary assets from every autocrlf setting.
* text=auto

# Unity serialized assets remain readable text.
*.anim text
*.asset text
*.unity text
*.prefab text
*.mat text
*.meta text
*.controller text
*.overrideController text
*.mask text
*.mixer text
*.terrainlayer text
*.renderTexture text
*.shadergraph text
*.shadersubgraph text
*.inputactions text
*.asmdef text
*.asmref text
*.wlt text

# Models, textures, fonts, audio, video and packed data are never normalized.
*.fbx binary
*.FBX binary
*.blend binary
*.glb binary
*.png binary
*.PNG binary
*.jpg binary
*.JPG binary
*.jpeg binary
*.tga binary
*.exr binary
*.psd binary
*.gif binary
*.bmp binary
*.tif binary
*.tiff binary
*.dds binary
*.ktx binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.aiff binary
*.flac binary
*.mp4 binary
*.mov binary
*.webm binary
*.avi binary
*.bytes binary
*.pdf binary
*.zip binary
*.7z binary
*.gz binary
*.rar binary
*.unitypackage binary
*.dll binary
*.exe binary
*.pdb binary
*.so binary
*.dylib binary
*.lib binary
*.a binary
